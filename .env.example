# Copy to `.env` (same directory as docker-compose.yml) and fill in.
# docker compose automatically picks up `.env`.

# ── Cerebras Cloud (free tier: 1M tokens/day, no card) ──
# 1. Sign up at https://cloud.cerebras.ai
# 2. Create an API key
# 3. Paste it below
CEREBRAS_API_KEY=

# Optional — pick a model. Defaults to llama3.1-8b (fastest).
# Valid IDs (2026-04): llama3.1-8b, gpt-oss-120b,
#                      qwen-3-235b-a22b-instruct-2507, zai-glm-4.7
CEREBRAS_MODEL=llama3.1-8b

# Set to 0 to disable LLM and run trie-only.
USE_LLM=1
